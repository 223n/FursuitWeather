{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fursuit-weather",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  // カスタムドメイン: 223n.techゾーン（同一Cloudflareアカウント）に
  // DNSレコードと証明書が自動作成される
  "routes": [
    {
      "pattern": "fursuit-weather.223n.tech",
      "custom_domain": true
    }
  ],
  // workers.devサブドメイン（fursuit-weather.223n.workers.dev）も有効を維持する。
  // 223n.techゾーンの設定（セキュリティ機能など）を経由しない検証用URLとして使える。
  // 重複コンテンツ対策は各ページのcanonicalタグ（カスタムドメイン指定）で担保済み
  "workers_dev": true,
  "assets": {
    // 静的アセット（UI）は無料・無制限で配信され、無料枠のリクエスト数を消費しない
    "directory": "./public",
    "binding": "ASSETS",
    // /api/* とHTMLページでWorkerを起動し、それ以外はアセット配信を優先する
    // （アセット配信は無料枠のリクエスト数を消費しないため、対象は最小限にする）。
    // HTMLはリクエストごとのnonceを差し込むためWorkerを通す必要がある。
    // 一覧はsrc/csp.tsのHTML_PATHSと一致させること（ずれるとnonceの無い
    // _headers側のCSPで配信され、scriptタグのnonceと食い違う）
    "run_worker_first": ["/api/*", "/", "/index.html", "/about", "/about.html", "/404.html"],
    // 存在しないパスには404.htmlを404ステータスで返す
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
