# FursuitWeather 環境変数テンプレート
#
# 本サービスのWorker自体は環境変数を必要としません。
# （気象データはAPIキー不要のOpen-Meteo JMAモデルAPIを使用）
#
# デプロイ時（GitHub Actions）には、リポジトリのSecretsに以下を設定してください。
# ここに実際の値を書いてコミットしないこと。

# Cloudflare APIトークン（「Edit Cloudflare Workers」テンプレートで作成）
# CLOUDFLARE_API_TOKEN=

# CloudflareアカウントID（ダッシュボードのWorkers & Pagesページで確認）
# CLOUDFLARE_ACCOUNT_ID=
